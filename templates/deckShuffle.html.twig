{% extends "base.html.twig" %}

{% block title %}Card{% endblock %}

{% block body %}
    <div class="cardholder">
        <h1>Shuffle the deck</h1>
        {% include "navbar/deckNavbar.html.twig" %}
        <h3>Get a shuffled deck for draw and draw MORE.</h3>
            {% for card in shuffle %}
            <div title='{{ card.getName }}'class='{{ card.getColor }}'> &#{{ card.getUnicode }};</div>
            {% endfor %}
        </div>
{% endblock %}
