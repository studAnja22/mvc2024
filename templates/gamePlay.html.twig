{% extends "base.html.twig" %}

{% block title %}Home{% endblock %}

{% block body %}
<div class="cardholder">
    <h1>Spela kortspelet 21</h1>
    {% include "navbar/gameNavbar.html.twig" %}
    <form method="post" action="">
        <nav>
            <ul>
                <li><input type="submit" class="button" name="game" value="New Game"
                    onclick="this.form.action='{{ path('game_action') }}';"></li>
                {% if (playersTurn) %}
                    <li><input type="submit" class="button" name="game" value="Draw"
                        onclick="this.form.action='{{ path('game_action') }}';"></li>
                {% endif %}
                {% if (gameOngoing == true) %}
                    <li><input type="submit" class="button" name="game" value="Hold"
                        onclick="this.form.action='{{ path('game_action') }}';"></li>
                {% endif %}
            </ul>
        </nav>
        
            <div class="pointHolder">
                <h2>Player points: {{playerScore}}</h2>
                {% if (playerGotMoreThan21 == true) %}
                    <h1>Bust! Bank Wins!</h1>
                {% endif %}
                {% if (gameOngoing == false) %}
                    <h2>{{winner}}</h2>
                {% endif %}
                <h2>Bank points: {{bankScore}}</h2>
            </div>
            <div class="game21">
                <div class="playerBox">
                    {% for card in player %}
                        <div title='{{ card.getName }}'class='{{ card.getColor }}'> &#{{ card.getUnicode }};</div>
                    {% endfor %}
                </div>
                <div class="bankBox">
                    {% for card in bank %}
                        <div title='{{ card.getName }}'class='{{ card.getColor }}'> &#{{ card.getUnicode }};</div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </form>
{% endblock %}