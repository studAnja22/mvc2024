{% extends "base.html.twig" %}

{% block title %}Home{% endblock %}

{% block body %}
    <div class="cardholder">
        <h1>Spela kortspelet 21</h1>
        {% include "navbar/gameNavbar.html.twig" %}
        <div class="intro">
            <h2>Flödesschema</h2>
            {# <img src="/img/kmom03/flodesdiagramMvc03.png" alt="flowchart"> #}
            <img src="{{ asset('img/kmom03/flodesdiagramMvc03.png') }}" alt="flowchart">
            <br>
            <h2>Pseudokod: Dynamiskt Ess</h2>
            {# <img src="/img/kmom03/pseudokodmvc03.png" alt="pseudocode"> #}
            <img src="{{ asset('img/kmom03/pseudokodmvc03.png') }}" alt="pseudocode">
            <br>
            <h2>Klasser</h2>
            <h3>Card</h3><p>Skapar ett kort.</p>
            <h3>CardGraphic</h3><p>Utökning (extends) av Card klassen som ger korten unicode grafik så de ser lite tjusiga ut.</p>
            <h3>DeckOfCards</h3><p>Skapar en hel kortlek med kortobjekt från Card klassen.</p>
            <h3>Hand</h3><p>Tar en kortlek från DeckOfCards klassen som Hand klassen kan interagera med.</p>
            <h3>Games</h3><p>Hanterar spelflödet, spelregler och speldata.</p>
        </div>
    </div>
{% endblock %}