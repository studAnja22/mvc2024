{% extends 'base.html.twig' %}

{% block title %}Library!{% endblock %}

{% block body %}
    <h1>Library</h1>
    {% include "library/libraryNavbar.html.twig" %}
    <div class="cardholder">
        <h1>[READ MANY] favorite books! ✅</h1>
        <h3>
            Click on one book to go to it's individual page [READ ONE] where you can read its description.<br>
            [READ ONE] includes the books full details and you may update it's data, or delete it as you wish.
        </h3>
        <table>
        <tr>
            <th>Cover</th>
            <th>Title</th>
            <th>Author</th>
            <th>ISBN</th>
        </tr>
        {% for book in books %}
            <tr>
                <td><a href="{{ path('book_by_id', {'id': book.getId|e }) }}">
                        <img class="coverImage" src="{{ asset('img/library/' ~ book.getCover|e) }}" alt="book cover"></td>
                    </a>
                <td>
                    <a href="{{ path('book_by_id', {'id': book.getId|e }) }}">
                        {{ book.getTitle|e }}
                    </a>
                </td>
                <td>
                    <a href="{{ path('book_by_id', {'id': book.getId|e }) }}">
                        {{ book.getAuthor|e }}
                    </a>
                </td>
                <td>
                    <a href="{{ path('book_by_id', {'id': book.getId|e }) }}">
                        {{ book.getISBN|e }}
                    </a>
                </td>
            </tr>
            
        {% endfor %}
        </table>
    </div>
{% endblock %}
